{
  "name": "dsh-harness-launcher",
  "version": "0.1.0",
  "description": "One desktop icon for DeepSeek Harness: starts it hidden when stopped, reopens the running UI, and restarts or closes it from the sidebar.",
  "type": "module",
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "icon.ico",
    "README.md",
    "LICENSE"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-slots"
      ]
    }
  },
  "keywords": [
    "deepseek-harness",
    "dsh",
    "plugin",
    "desktop",
    "launcher",
    "windows"
  ],
  "os": [
    "win32"
  ],
  "engines": {
    "node": ">=20"
  },
  "license": "MIT"
}
